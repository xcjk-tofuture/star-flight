  "tasks": [
    {
      "label": "CMake: configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "process",
