    },
    {
      "label": "VLLINK: flash HEX",
      "type": "process",
      "command": "C:/Users/xcjk/Documents/Codex/2026-10-07/https-github-com-xcjk-tofuture-star/work/toolchains/xpack-openocd-0.12.0-7/bin/openocd.exe",
      "args": [
        "-s",
        "C:/Users/xcjk/Documents/Codex/2026-10-07/https-github-com-xcjk-tofuture-star/work/toolchains/xpack-openocd-0.12.0-7/openocd/scripts",
        "-f",
        "${workspaceFolder}/openocd/board-cmsis-dap.cfg",
